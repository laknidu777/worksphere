{
  "name": "worksphere-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm --workspace=@worksphere/web run dev",
    "web:build": "npm --workspace=@worksphere/web run build",
    "web:lint": "npm --workspace=@worksphere/web run lint",
    "web:test": "npm --workspace=@worksphere/web run test"
  }
}
