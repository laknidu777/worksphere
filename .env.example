# -----------------------------------------------------------------------------
# WorkSphere Local Development Environment Template
# Copy this file to .env and adjust variables as needed for local development.
# WARNING: NEVER COMMIT SENSITIVE PRODUCTION SECRETS TO VERSION CONTROL!
# -----------------------------------------------------------------------------

# Application Environment
APP_ENV=development
API_PORT=8080
WEB_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Regional Defaults (Sri Lanka)
DEFAULT_CURRENCY=LKR
DEFAULT_TIMEZONE=Asia/Colombo
DEFAULT_LOCALE=en-LK

# Local PostgreSQL Configuration
POSTGRES_USER=worksphere
POSTGRES_PASSWORD=worksphere_local_secret
POSTGRES_DB=worksphere
POSTGRES_PORT=5432
DATABASE_URL=postgres://worksphere:worksphere_local_secret@localhost:5432/worksphere?sslmode=disable

# Local Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Authentication (Cognito OIDC Placeholders)
# Local development uses mock auth provider by default (no AWS account required).
ENABLE_MOCK_AUTH=true
COGNITO_USER_POOL_ID=ap-south-1_placeholder
COGNITO_CLIENT_ID=placeholder_client_id
COGNITO_CLIENT_SECRET=placeholder_client_secret
COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_placeholder

# Next.js BFF Session Secret (Random 32-byte string for cookie encryption)
SESSION_SECRET=worksphere_local_dev_session_secret_32_chars!

# Candidate Payment Provider (PayHere Placeholder)
PAYHERE_MERCHANT_ID=placeholder_merchant_id
PAYHERE_MERCHANT_SECRET=placeholder_merchant_secret
PAYHERE_SANDBOX=true

# Candidate Email Provider (Amazon SES Placeholder)
SES_REGION=ap-south-1
SES_FROM_EMAIL=no-reply@worksphere.lk
